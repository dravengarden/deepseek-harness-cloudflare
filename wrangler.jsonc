{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deepseek-harness-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 5
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HARNESS",
        "class_name": "HarnessObject"
      },
      {
        "name": "Sandbox",
        "class_name": "Sandbox"
      },
      {
        "name": "MAILBOX",
        "class_name": "ControlMailbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HarnessObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Sandbox"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["QuestionGate"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["ControlMailbox"]
    },
    {
      "tag": "v5",
      "deleted_classes": ["QuestionGate"]
    }
  ],
  "vars": {
    "BACKUP_BUCKET_NAME": "dsh-cf-workspace-backups"
  },
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "dsh-cf-workspace-backups"
    }
  ]
}
