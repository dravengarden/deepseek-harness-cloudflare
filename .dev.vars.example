# Fill these locally. Do not commit .dev.vars.
DEEPSEEK_API_KEY=
DSH_CF_ACCESS_KEY=
DEEPSEEK_MODEL=deepseek-flash
# wrangler dev only. Omit in production.
LOCAL_DEV=1
# Backups use the BACKUP_BUCKET binding (localBucket: true). No R2 API tokens.
# Production identity (Cloudflare Access). Leave unset to use DSH_CF_ACCESS_KEY.
# TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# POLICY_AUD=
